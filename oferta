    <script>
        // Script do contador regressivo de urgência
        function iniciarContagemRegressiva() {
            // Define 2 horas de validade para a oferta na página OFERTA
            let tempoRestante = 2 * 60 * 60; 

            const timerElement = document.getElementById('timer-combo-oab');
            
            const intervalo = setInterval(() => {
                let horas = Math.floor(tempoRestante / 3600);
                let minutos = Math.floor((tempoRestante % 3600) / 60);
                let segundos = tempoRestante % 60;

                horas = horas < 10 ? '0' + horas : horas;
                minutos = minutos < 10 ? '0' + minutos : minutos;
                segundos = segundos < 10 ? '0' + segundos : segundos;

                timerElement.innerHTML = `<span>${horas}</span>:<span>${minutos}</span>:<span>${segundos}</span>`;

                if (tempoRestante > 0) {
                    tempoRestante--;
                } else {
                    clearInterval(intervalo);
                    timerElement.innerHTML = "EXPIRADO";
                }
            }, 1000);
        }

        iniciarContagemRegressiva();

        // Rastreamento de eventos atualizado para OFERTA (planilhas / analytics)
        document.querySelectorAll('.btn-comprar').forEach(btn => {
            btn.addEventListener('click', function() {
                console.log('Evento de clique registrado na página OFERTA para o produto:', this.getAttribute('data-id'));
